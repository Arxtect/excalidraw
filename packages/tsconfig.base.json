{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "types": ["node"],
    "paths": {
      "@pageflux/common": ["./common/src/index.ts"],
      "@pageflux/common/*": ["./common/src/*"],
      "@pageflux/element": ["./element/src/index.ts"],
      "@pageflux/element/*": ["./element/src/*"],
      "@pageflux/excalidraw": ["./excalidraw/index.tsx"],
      "@pageflux/excalidraw/*": ["./excalidraw/*"],
      "@pageflux/math": ["./math/src/index.ts"],
      "@pageflux/math/*": ["./math/src/*"],
      "@pageflux/utils": ["./utils/src/index.ts"],
      "@pageflux/utils/*": ["./utils/src/*"]
    }
  },
  "files": ["./excalidraw/css.d.ts"]
}
